<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Niagara2EfkMapper</AssemblyName>
    <RootNamespace>Niagara2Efk.Mapper</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- EffekseerCore pins Platforms=x64; match it so ProjectReference platform
         negotiation resolves instead of trying to build it as AnyCPU. -->
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EffekseerCore170e\EffekseerCore170e.csproj" />
  </ItemGroup>

</Project>
