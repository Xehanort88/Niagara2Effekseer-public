<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wrapper around the pristine Effekseer 1.80.3 checkout (tag 1803) in
    external/Effekseer1803, the version of the web runtime the test project runs.

    Same approach as EffekseerCore170e: glob the upstream sources rather than use
    or edit upstream's project file, so the checkout stays byte-identical to the
    tag and our InternalsVisibleTo can be added from outside it. Upstream's own
    csproj at this tag is already SDK-style net9.0 with these defines and packages.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>EffekseerCore</AssemblyName>
    <RootNamespace>Effekseer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>SCRIPT_ENABLED;DOTNET_STARNDARD;</DefineConstants>
    <!-- Upstream code, not ours: don't fail the build on its style warnings. -->
    <NoWarn>$(NoWarn);CS8981;CS0659;CS0067;CS0649;SYSLIB0021;CA2200</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <EfkCoreDir>..\..\external\Effekseer1803\Dev\Editor\EffekseerCore</EfkCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(EfkCoreDir)\**\*.cs" Exclude="$(EfkCoreDir)\Properties\AssemblyInfo.cs;$(EfkCoreDir)\bin\**\*.cs;$(EfkCoreDir)\obj\**\*.cs" />
    <Compile Include="AssemblyAttributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IronPython" Version="2.7.9" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>
